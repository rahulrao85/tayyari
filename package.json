{
  "name": "tayyari",
  "version": "1.0.0",
  "private": true,
  "description": "Tayyari: a GenAI celebration planner that revises your plan instead of restarting it.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/main.ts",
    "build": "vite build && node scripts/build-server.mjs && node scripts/precompress.mjs",
    "start": "node dist/server.mjs",
    "start:local": "node --env-file-if-exists=.env dist/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:unused": "knip",
    "lint:dupes": "jscpd",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "budget:bundle": "node scripts/bundle-budget.mjs",
    "check": "npm run typecheck && npm run lint && npm run lint:dupes && npm run format:check && npm run coverage"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "~1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "~5.0.4",
    "axe-core": "~4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "~7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jscpd": "^4.3.0",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.2",
    "vite": "~8.3.4",
    "vitest": "~5.0.4"
  }
}
